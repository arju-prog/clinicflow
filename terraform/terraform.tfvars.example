# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# Never put AWS access keys here: Terraform reads credentials from `aws configure` / `aws login`
# or environment variables.

aws_region         = "ap-south-1"
project            = "clinicflow"
environment        = "dev"
cluster_name       = "clinicflow-eks"
kubernetes_version = "1.34"

# The GitHub repository allowed to deploy via OIDC (owner/name).
github_repository = "arju-prog/clinicflow"

# GitHub's immutable OIDC subject for this repo (changes if the repo is deleted and re-created):
#   gh api repos/arju-prog/clinicflow/actions/oidc/customization/sub --jq .sub_claim_prefix
github_oidc_subject_prefix = "repo:arju-prog@180331249/clinicflow@1422194852"

# Set to false if your AWS account already has a token.actions.githubusercontent.com provider.
create_github_oidc_provider = true

node_instance_types = ["m7i-flex.large"] # Free Tier eligible (AWS Free plan accounts cannot launch t3.medium)
node_capacity_type  = "ON_DEMAND" # "SPOT" is much cheaper for a demo
node_min_size       = 2
node_desired_size   = 2
node_max_size       = 2   # 2 x 2 vCPU fits the default 5 vCPU on-demand quota of new accounts
