# Rendered at container start by the nginx image's envsubst step:
#   ${BACKEND_URL}           where /api is proxied (Compose: http://backend:8000,
#                            Kubernetes: the backend Service's FQDN, set by Helm)
#   ${NGINX_LOCAL_RESOLVERS} DNS servers from /etc/resolv.conf
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  # Resolve the backend at request time (not only at startup) so nginx boots even if the
  # backend Service is not resolvable yet, and follows Service IP changes.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
  set $backend "${BACKEND_URL}";

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  # Same-origin API proxy. In Kubernetes the Ingress usually sends /api straight to the
  # backend, but this keeps `kubectl port-forward` to the frontend working too.
  location /api/ {
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  # Probe target for Docker HEALTHCHECK and Kubernetes liveness/readiness.
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Vite fingerprints asset filenames, so they can be cached forever.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # SPA fallback: any unknown path serves index.html.
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache";
  }
}
